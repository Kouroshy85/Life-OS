{
  "$schema": "../gen/schemas/desktop-schema.json",
  "capabilities": [
    {
      "identifier": "default",
      "description": "Capabilities for the main Life OS window",
      "windows": ["main"],
      "permissions": ["core:default", "core:window:allow-request-user-attention", "core:window:allow-set-fullscreen", "core:window:allow-set-theme"]
    },
    {
      "identifier": "local-ai",
      "description": "Lets the AI assistant settings open a file picker to import a GGUF model (desktop only)",
      "windows": ["main"],
      "platforms": ["windows", "macOS", "linux"],
      "permissions": ["dialog:allow-open"]
    }
  ]
}
